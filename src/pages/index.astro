---
import Audiences from "../components/Audiences.astro";
import ClientStrip from "../components/ClientStrip.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import Process from "../components/Process.astro";
import Schema from "../components/Schema.astro";
import Services from "../components/Services.astro";
import { faq } from "../data/faq";
import { formatPrice, improvements, services } from "../data/services";
import { personSchema, schemaIds, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Website laten maken voor zzp’ers en coaches | Lorent Webworks";
// Op de homepage alleen deze vragen. De overige vragen blijven in src/data/faq.ts staan.
const homeFaqQuestions = [
  "Wat kost een website laten maken?",
  "Hoe lang duurt het?",
  "Wat als ik al een website heb?",
  "Moet ik zelf de teksten schrijven?",
  "Word ik gevonden in Google en ChatGPT?",
  "Van wie is de website na de oplevering?",
  "Kan ik later dingen laten aanpassen?",
  "Werk je alleen in Amsterdam?",
];
const homeFaq = faq.filter((item) => homeFaqQuestions.includes(item.q));
const [lp] = services;
const description = `Website laten maken als zzp’er, coach of stichting? Vaste prijs vanaf ${formatPrice(lp.price)}, live binnen 5 werkdagen en alles op jouw naam. Plan een gratis kennismaking.`;

const priceRange = `${formatPrice(Math.min(...improvements.map((i) => i.price)))} - ${formatPrice(Math.max(...services.map((x) => x.price)))}`;

const schema = [
  personSchema,
  {
    "@type": "ProfessionalService",
    "@id": schemaIds.organization,
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/android-chrome-512x512.png`,
    image: `${site.url}/og-image.png`,
    description:
      "Websites die bezoekers laten bellen, boeken, reserveren of doneren. Voor zzp’ers, ondernemers en stichtingen in heel Nederland.",
    address: {
      "@type": "PostalAddress",
      addressLocality: site.city,
      addressCountry: site.country,
    },
    areaServed: { "@type": "Country", name: "Netherlands" },
    founder: { "@id": schemaIds.person },
    identifier: {
      "@type": "PropertyValue",
      propertyID: "KvK",
      value: site.kvk,
    },
    sameAs: [site.linkedin, site.instagram],
    knowsAbout: [
      "Website laten maken",
      "Landingspagina",
      "Websitecheck",
      "Zoekmachineoptimalisatie",
      "Digitale toegankelijkheid",
    ],
    slogan:
      "Websites die bezoekers laten bellen, boeken, reserveren of doneren.",
    priceRange,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Diensten en prijzen",
      itemListElement: [
        ...services.map((s) => ({
          "@type": "Offer",
          name: s.name,
          description: s.description,
          // "Vanaf"-prijs: minimumprijs, geen vaste prijs.
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: s.price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: false,
          },
          itemOffered: {
            "@type": "Service",
            name: s.name,
            description: s.description,
          },
        })),
        ...improvements.map((item) => ({
          "@type": "Offer",
          name: item.name,
          description: item.schemaDescription,
          priceSpecification: {
            "@type": "PriceSpecification",
            price: item.price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: false,
          },
          itemOffered: {
            "@type": "Service",
            name: item.name,
            description: item.schemaDescription,
          },
        })),
      ],
    },
  },
  {
    "@type": "WebSite",
    "@id": schemaIds.website,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: "nl-NL",
    publisher: { "@id": schemaIds.organization },
  },
  {
    "@type": "FAQPage",
    mainEntity: homeFaq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} nav="home">
  <Schema slot="head" data={schema} />
  <Hero />
  <ClientStrip />
  <Audiences />
  <Process />
  <Services />
  <Faq
    items={homeFaq}
    title="Vragen over een website laten maken"
  />
  <Contact />
</BaseLayout>
