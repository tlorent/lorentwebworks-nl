---
import Audiences from "../components/Audiences.astro";
import ClientStrip from "../components/ClientStrip.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import Process from "../components/Process.astro";
import Schema from "../components/Schema.astro";
import Services from "../components/Services.astro";
import { faq } from "../data/faq";
import {
  formatPrice,
  improvements,
  nonprofitDiscount,
  services,
} from "../data/services";
import { personSchema, schemaIds, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Website laten maken voor ondernemers | Lorent Webworks";
// Op de homepage alleen deze vragen. De overige vragen blijven in src/data/faq.ts staan.
const homeFaqQuestions = [
  "Wat kost een website laten maken?",
  "Wat als ik al een website heb?",
  "Moet ik zelf de teksten schrijven?",
  "Word ik gevonden in Google en ChatGPT?",
  "Van wie is de website na de oplevering?",
  "Kan ik later dingen laten aanpassen?",
];
const homeFaq = faq.filter((item) => homeFaqQuestions.includes(item.q));
const [lp] = services;
const description = `Website laten maken die klanten oplevert? Vanaf ${formatPrice(lp.price)}, eenmalig en excl. btw. Goede doelen en stichtingen krijgen ${nonprofitDiscount}% korting.`;

const schema = [
  {
    "@type": "ProfessionalService",
    "@id": schemaIds.organization,
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/android-chrome-512x512.png`,
    image: `${site.url}/og-image.png`,
    description:
      "Websites die klanten opleveren voor zelfstandigen, kleine ondernemers, goede doelen en initiatieven in heel Nederland.",
    address: {
      "@type": "PostalAddress",
      addressLocality: site.city,
      addressCountry: site.country,
    },
    areaServed: { "@type": "Country", name: "Netherlands" },
    founder: personSchema,
    identifier: {
      "@type": "PropertyValue",
      propertyID: "KvK",
      value: site.kvk,
    },
    sameAs: [site.linkedin],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Diensten en prijzen",
      itemListElement: [
        ...services.map((s) => ({
          "@type": "Offer",
          name: s.name,
          description: s.description,
          // "Vanaf"-prijs: minimumprijs, geen vaste prijs.
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: s.price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: false,
          },
          itemOffered: {
            "@type": "Service",
            name: s.name,
            description: s.description,
          },
        })),
        ...improvements.map((item) => ({
          "@type": "Offer",
          name: item.name,
          description: item.label,
          priceSpecification: {
            "@type": "PriceSpecification",
            price: item.price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: false,
          },
          itemOffered: {
            "@type": "Service",
            name: item.name,
            description: item.label,
          },
        })),
      ],
    },
  },
  {
    "@type": "WebSite",
    "@id": schemaIds.website,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: "nl-NL",
    publisher: { "@id": schemaIds.organization },
  },
  {
    "@type": "FAQPage",
    mainEntity: homeFaq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} nav="home">
  <Schema slot="head" data={schema} />
  <Hero />
  <ClientStrip />
  <Audiences />
  <Process />
  <Services />
  <Faq
    items={homeFaq}
    title="Vragen over een website laten maken"
  />
  <Contact />
</BaseLayout>
