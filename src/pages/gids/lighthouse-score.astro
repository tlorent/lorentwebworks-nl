---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import {
  device,
  measured,
  measuredIso,
  reportUrl,
  scores,
} from "../../data/lighthouse";
import GuideLayout from "../../layouts/GuideLayout.astro";

const guides = (await getCollection("gids")).sort(
  (a, b) => a.data.order - b.data.order,
);
const title = "Wat een Lighthouse-score van 100 betekent";
const seoTitle = "Lighthouse-score: wat betekent 100? | Lorent Webworks";
const description =
  "Mijn website scoort 100 op Google Lighthouse. Lees wat de score meet, wat hij niet vertelt en hoe ik jouw website op dezelfde manier bouw.";
const intro =
  "Mijn eigen website scoort 100 op alle vier de onderdelen van Google Lighthouse. Hier leg ik uit wat die score meet, wat hij je niet vertelt en hoe ik jouw website op dezelfde manier opbouw.";
const measuredDate = new Date(measuredIso);

// De pagina gebruikt dezelfde opmaak als de gidsen. De layout verwacht een gidsentry, dus geven we de velden mee.
const guide = {
  data: {
    title,
    seoTitle,
    crumb: "Lighthouse-score",
    slug: "lighthouse-score",
    description,
    intro,
    readingTime: 5,
    published: measuredDate,
    updated: measuredDate,
    order: 99,
    cta: {
      title: "Benieuwd hoe jouw website scoort?",
      text: "Met de Websitecheck bekijk ik je huidige website en krijg je concrete verbeterpunten. Of plan een kennismaking en vertel wat je nodig hebt.",
      button: "Plan een kennismaking",
    },
  },
} as unknown as CollectionEntry<"gids">;

const headings: MarkdownHeading[] = [
  { depth: 2, slug: "wat-is-lighthouse", text: "Wat is Lighthouse?" },
  { depth: 2, slug: "de-vier-onderdelen", text: "De vier onderdelen" },
  {
    depth: 2,
    slug: "wat-een-score-niet-kan-zeggen",
    text: "Wat een score niet kan zeggen",
  },
  {
    depth: 2,
    slug: "hoe-ik-dit-aanpak",
    text: "Hoe ik dit aanpak voor jouw website",
  },
  {
    depth: 2,
    slug: "wat-jouw-score-omlaag-kan-halen",
    text: "Wat jouw score omlaag kan halen",
  },
  {
    depth: 2,
    slug: "wat-je-er-zelf-van-merkt",
    text: "Wat je er zelf van merkt",
  },
  { depth: 2, slug: "controleer-het-zelf", text: "Controleer het zelf" },
];

const onderdelen = [
  {
    naam: "Snelheid",
    engels: "Performance",
    meet: "hoe snel je pagina zichtbaar is, hoe snel een bezoeker erop kan klikken en of de pagina tijdens het laden blijft staan in plaats van te verspringen.",
    doe: "ik bouw met Astro, dat nauwelijks JavaScript naar de bezoeker stuurt. Afbeeldingen worden verkleind en in een modern formaat geleverd, met vaste afmetingen zodat er niets verspringt. Lettertypes laad ik zo dat tekst direct leesbaar is.",
  },
  {
    naam: "Toegankelijkheid",
    engels: "Accessibility",
    meet: "een automatische test op onder meer kleurcontrast, beschrijvingen bij afbeeldingen, labels bij formuliervelden en een logische opbouw van koppen.",
    doe: "ik bouw met correcte HTML, kies kleuren met voldoende contrast en zorg dat alles met het toetsenbord te bedienen is, met een zichtbare focus. Daarbovenop test ik handmatig, omdat de automatische test maar een deel van de problemen vindt.",
  },
  {
    naam: "Vindbaarheid",
    engels: "SEO",
    meet: "of zoekmachines je pagina kunnen lezen en begrijpen. Het gaat om een titel en omschrijving per pagina, duidelijke koppen, werkende links en een goede weergave op mobiel.",
    doe: "elke pagina krijgt een eigen titel en omschrijving, een heldere kopstructuur en een sitemap. Zo staat de technische basis klaar.",
  },
  {
    naam: "Best practices",
    engels: "",
    meet: "of de website veilig en netjes is gebouwd. Denk aan een beveiligde verbinding (HTTPS), geen foutmeldingen in de browser en geen verouderde onderdelen.",
    doe: "ik lever de site via HTTPS, houd de onderdelen actueel, controleer de browserconsole op fouten en stel beveiligingsheaders in waar de hosting dat toelaat.",
  },
];
---
<GuideLayout guide={guide} headings={headings} others={guides}>

    <section aria-labelledby="overzicht-titel">
      <h2 id="overzicht-titel" class="sr-only">Scores</h2>
      <dl class="grid gap-2 text-sm">
        {
          scores.map((s) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-border py-2">
              <dt class="text-text-soft">
                {s.label} <span class="text-text-muted">({s.hint})</span>
              </dt>
              <dd>
                <strong class="text-text">{s.score}</strong>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-sm text-text-muted">
        Gemeten op {device} op {measured} met Google Lighthouse via PageSpeed Insights.
        <a href={reportUrl} target="_blank" rel="noopener noreferrer" class="mt-2 block font-semibold text-accent-text underline underline-offset-4 focus-ring">
          Bekijk het volledige rapport<span class="sr-only"> (opent in een nieuw tabblad)</span>
        </a>
      </p>
    </section>

          <h2 id="wat-is-lighthouse">Wat is Lighthouse?</h2>
      <p class="measure">
        Lighthouse is een gratis testprogramma van Google. Het opent een pagina, meet hoe snel die laadt en controleert
        honderden technische punten. Het resultaat zijn vier scores van 0 tot 100. Je vindt Lighthouse terug in Chrome en
        in PageSpeed Insights, waar je elke website mee kunt testen.
      </p>

      <h2 id="de-vier-onderdelen">De vier onderdelen</h2>
      {
        onderdelen.map((o) => (
          <>
            <h3>{o.naam}{o.engels && ` (${o.engels})`}</h3>
            <p class="measure">
              <strong>Wat het meet:</strong> {o.meet}
            </p>
            <p class="measure">
              <strong>Wat ik ervoor doe:</strong> {o.doe}
            </p>
          </>
        ))
      }

      <h2 id="wat-een-score-niet-kan-zeggen">Wat een score niet kan zeggen</h2>
      <ul class="measure">
        <li><strong>Vindbaarheid:</strong> een 100 betekent dat de techniek op orde is. Waar je in Google verschijnt hangt ook af van je teksten, je concurrenten en de leeftijd van je site. Dat kan niemand garanderen, ik ook niet.</li>
        <li><strong>Toegankelijkheid:</strong> de automatische test dekt een deel van de richtlijnen. Een volledige controle vraagt ook handmatig testen, bijvoorbeeld met het toetsenbord en een schermlezer.</li>
        <li><strong>Momentopname:</strong> scores kunnen per meting een paar punten verschillen, afhankelijk van apparaat, netwerk en drukte op de testserver.</li>
        <li><strong>Testomgeving:</strong> Lighthouse meet in een gesimuleerde situatie. Een bezoeker met een oudere telefoon of een zwak netwerk kan het anders ervaren.</li>
      </ul>

      <h2 id="hoe-ik-dit-aanpak">Hoe ik dit aanpak voor jouw website</h2>
      <ol class="measure">
        <li>Ik bouw licht. Geen zware thema's of plug-ins, alleen wat jouw website nodig heeft.</li>
        <li>Ik meet tijdens het bouwen, zodat problemen vroeg opvallen.</li>
        <li>Ik test handmatig op toetsenbord en mobiel, naast de automatische test.</li>
        <li>Ik meet bij oplevering opnieuw en deel het rapport met je.</li>
        <li>Ik leg uit wat de cijfers betekenen, zodat je ze zelf kunt lezen.</li>
      </ol>

      <h2 id="wat-jouw-score-omlaag-kan-halen">Wat jouw score omlaag kan halen</h2>
      <p class="measure">
        Externe onderdelen kosten snelheid. Denk aan een boekingstool, chatwidget, trackingscripts, ingesloten video's en
        grote foto's die je later zelf toevoegt. Ik bouw ze zo licht mogelijk in en vertel je vooraf wat een onderdeel aan
        snelheid kost. Daarom beloof ik geen 100 voor elke website. Ik bespreek vooraf wat haalbaar is voor jouw situatie.
      </p>

      <h2 id="wat-je-er-zelf-van-merkt">Wat je er zelf van merkt</h2>
      <p class="measure">
        Een snelle website laat bezoekers niet wachten, ook op een telefoon met matig bereik. Een toegankelijke website is
        voor iedereen prettig leesbaar, ook buiten in de zon. Een technisch nette website heeft minder kans op storingen en
        is makkelijker te onderhouden.
      </p>

      <h2 id="controleer-het-zelf">Controleer het zelf</h2>
      <ol class="measure">
        <li>Ga naar pagespeed.web.dev.</li>
        <li>Vul het adres van de website in en kies Analyseren.</li>
        <li>Wissel tussen de tabs Mobiel en Desktop.</li>
        <li>Draai de test een paar keer, want de score kan een paar punten schommelen.</li>
      </ol>

</GuideLayout>
