---
import { getCollection } from "astro:content";
import GuideCard from "../../components/GuideCard.astro";
import GuideCta from "../../components/GuideCta.astro";
import Pattern from "../../components/Pattern.astro";
import Schema from "../../components/Schema.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = (await getCollection("gids")).sort(
  (a, b) => a.data.order - b.data.order,
);
const title = "Gids: alles over een website laten maken | Lorent Webworks";
const description =
  "Praktische uitleg voor ondernemers en organisaties die een nieuwe website overwegen. Over kosten, kiezen en wat er op een goede site hoort.";

const schema = [
  {
    "@type": "CollectionPage",
    name: "Alles wat je wilt weten over een website laten maken",
    url: `${site.url}/gids/`,
    inLanguage: "nl-NL",
    hasPart: guides.map((g) => ({
      "@type": "Article",
      headline: g.data.title,
      url: `${site.url}/gids/${g.data.slug}/`,
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Gids",
        item: `${site.url}/gids/`,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} nav="gids">
  <Schema slot="head" data={schema} />
  <!-- Geen reveal-animatie: de kop staat boven de vouw. -->
  <header class="relative pt-14 pb-16 md:pt-20 md:pb-20">
    <Pattern variant="dots" />
    <div class="relative container-page">
      <SectionLabel>Gids</SectionLabel>
      <h1 class="mt-6 max-w-6xl text-display font-stretch-116% text-balance">
        Alles wat je wilt weten over een website laten maken
      </h1>
      <p class="mt-6 max-w-3xl text-intro text-text-soft">
        Praktische uitleg voor ondernemers, praktijken en organisaties die een nieuwe website overwegen. Over kosten,
        kiezen, voorbereiden en wat er op een goede site hoort.
      </p>
    </div>
  </header>
  <section aria-labelledby="alle-gidsen" class="bg-surface py-16 md:py-24">
    <div class="reveal container-page">
      <h2 id="alle-gidsen" class="sr-only">Alle gidsen</h2>
      <div class="grid grid-fit-75 gap-3.5">
        {
          guides.map((g) => (
            <GuideCard
              title={g.data.cardTitle}
              teaser={g.data.teaser}
              slug={g.data.slug}
              readingTime={g.data.readingTime}
              order={g.data.order}
            />
          ))
        }
      </div>
      <GuideCta class="mt-14" />
    </div>
  </section>
</BaseLayout>
