---
import { getCollection } from "astro:content";
import GuideCard from "../../components/GuideCard.astro";
import GuideCta from "../../components/GuideCta.astro";
import Schema from "../../components/Schema.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = (await getCollection("gids")).sort(
  (a, b) => a.data.order - b.data.order,
);
const title = "Gids: alles over een website laten maken | Lorent Webworks";
const description =
  "Praktische uitleg voor ondernemers en organisaties die een nieuwe website overwegen. Over kosten, kiezen en wat er op een goede site hoort.";

const schema = [
  {
    "@type": "CollectionPage",
    name: "Alles wat je wilt weten over een website laten maken",
    url: `${site.url}/gids/`,
    inLanguage: "nl-NL",
    hasPart: [
      ...guides.map((g) => ({
        "@type": "Article",
        headline: g.data.title,
        url: `${site.url}/gids/${g.data.slug}/`,
      })),
      {
        "@type": "Article",
        headline: "Lighthouse-score uitgelegd",
        url: `${site.url}/gids/lighthouse-score/`,
      },
    ],
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Gids",
        item: `${site.url}/gids/`,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} nav="gids">
  <Schema slot="head" data={schema} />
  <!-- Geen reveal-animatie: de kop staat boven de vouw. -->
  <header class="relative pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="relative container-page">
      <SectionLabel>Gids</SectionLabel>
      <h1 class="mt-6 max-w-6xl text-display font-stretch-116% text-balance">
        Alles wat je wilt weten over een website laten maken
      </h1>
      <p class="mt-6 max-w-3xl text-intro text-text-soft">
        Praktische uitleg voor ondernemers, praktijken en organisaties die een nieuwe website overwegen. Over kosten,
        kiezen, voorbereiden en wat er op een goede site hoort.
      </p>
    </div>
  </header>
  <section aria-label="Alle gidsen" class="bg-surface py-16 md:py-24">
    <div class="reveal container-page">
      <h2 class="text-heading font-stretch-115%">Je gaat een nieuwe website laten maken</h2>
      <div class="mt-8 grid grid-fit-75 gap-3.5">
        {
          guides
            .filter((g) => [1, 2, 3, 5].includes(g.data.order))
            .map((g) => (
              <GuideCard
                title={g.data.cardTitle}
                teaser={g.data.teaser}
                slug={g.data.slug}
                readingTime={g.data.readingTime}
                order={g.data.order}
              />
            ))
        }
      </div>

      <h2 class="mt-16 text-heading font-stretch-115%">Je hebt al een website</h2>
      <p class="mt-4 max-w-3xl text-body-lg text-text-soft">
        Wil je dat ik je site doorloop? Met de <a href="/website-verbeteren/#websitecheck" class="rounded-sm font-semibold text-accent-text underline underline-offset-4 focus-ring">websitecheck</a> krijg je de 10 belangrijkste verbeterpunten op volgorde van belang.
      </p>
      <div class="mt-8 grid grid-fit-75 gap-3.5">
        {
          guides
            .filter((g) => g.data.order === 4)
            .map((g) => (
              <GuideCard
                title={g.data.cardTitle}
                teaser={g.data.teaser}
                slug={g.data.slug}
                readingTime={g.data.readingTime}
                order={g.data.order}
              />
            ))
        }
        <GuideCard
          title="Lighthouse-score uitgelegd"
          teaser="Wat een score van 100 meet, wat hij niet zegt en hoe je jouw eigen website zelf controleert."
          slug="lighthouse-score"
          href="/gids/lighthouse-score/"
          readingTime={4}
          order={6}
        />
      </div>
      <GuideCta class="mt-14" />
    </div>
  </section>
</BaseLayout>
