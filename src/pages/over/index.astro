---
import { Image } from "astro:assets";
import timPortret from "../../assets/photos/tim-2.jpg";
import BookButton from "../../components/BookButton.astro";
import Schema from "../../components/Schema.astro";
import SlotPhoto from "../../components/SlotPhoto.astro";
import { ownStory } from "../../data/booking.mjs";
import { personSchema, site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Over Tim Lorent, senior frontend developer | Lorent Webworks";
const description =
  "Ik ben Tim Lorent, senior frontend developer in Amsterdam. Sinds 2017 bouw ik websites die iets moeten opleveren, voor zzp'ers, mkb en goede doelen.";

// Alinea's uit {{OVER_VERHAAL}}. Zolang de waarde leeg is, valt de sectie weg.
const storyParagraphs = ownStory
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const steps = [
  {
    title: "Ik begin bij je doel.",
    text: "We bepalen eerst wat de site moet opleveren.",
  },
  {
    title: "Je weet vooraf waar je aan toe bent.",
    text: "Prijs, planning en afbakening spreken we vooraf af.",
  },
  {
    title: "Alles staat op jouw naam.",
    text: "Domein, site en accounts blijven van jou.",
  },
];

const schema = [
  {
    "@type": "ProfilePage",
    url: `${site.url}/over/`,
    name: title,
    mainEntity: personSchema,
  },
];
---

<BaseLayout title={title} description={description} nav="over" ogType="website">
  <Schema slot="head" data={schema} />

  <header class="container-page pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="flex flex-wrap items-center gap-x-12 gap-y-10">
      <div class="min-w-0 grow basis-110">
        <h1 class="text-display font-stretch-116% text-balance">Hoi, ik ben Tim</h1>
        <p class="mt-6 max-w-2xl text-intro text-text-soft">
          Ik ben senior frontend developer in Amsterdam en werk sinds 2017 aan websites die iets moeten opleveren.
        </p>
      </div>
      <Image src={timPortret} alt="Portret van Tim Lorent" class="h-auto w-56 rounded-hero md:w-72" widths={[224, 288, 500]} sizes="(min-width: 768px) 288px, 224px" />
    </div>
  </header>

  {
    storyParagraphs.length > 0 && (
      <section aria-labelledby="verhaal-titel" class="container-page pb-20 md:pb-28">
        <h2 id="verhaal-titel" class="text-title font-stretch-115%">Mijn verhaal</h2>
        <div class="mt-8 max-w-3xl space-y-6 text-body-lg text-text-soft">
          {storyParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )
  }

  <section aria-labelledby="zo-werk-ik" class="container-page pb-20 md:pb-28">
    <h2 id="zo-werk-ik" class="text-title font-stretch-115%">Zo werk ik</h2>
    <ul class="mt-8 grid grid-fit-70 gap-4">
      {
        steps.map((step) => (
          <li class="rounded-panel bg-surface p-6 md:p-8">
            <p class="text-h3 font-stretch-110%">{step.title}</p>
            <p class="mt-3 text-text-soft">{step.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="waar-titel" class="container-page pb-20 md:pb-28">
    <h2 id="waar-titel" class="text-title font-stretch-115%">Waar ik heb gewerkt</h2>
    <p class="mt-6 max-w-3xl text-body-lg text-text-soft">
      Ik werkte voor HEMA, GrandVision, bol. en T-Mobile. Daarnaast geef ik les bij HackYourFuture.
    </p>
  </section>

  <section aria-labelledby="over-cta" class="container-page pb-20 md:pb-28">
    <div class="on-block flex flex-wrap items-center justify-between gap-x-10 gap-y-6 rounded-hero p-6 md:p-12">
      <div class="max-w-2xl">
        <h2 id="over-cta" class="text-heading font-stretch-115%">Benieuwd of we bij elkaar passen?</h2>
        <p class="mt-3 text-on-block-muted">Plan een gratis kennismaking van 30 minuten.</p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <SlotPhoto name="tim-2" alt="Foto van Tim Lorent" size={56} />
        <BookButton base="/" variant="on-block" />
      </div>
    </div>
  </section>
</BaseLayout>
