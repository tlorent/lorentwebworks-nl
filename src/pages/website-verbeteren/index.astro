---
import BookButton from "../../components/BookButton.astro";
import { formatPrice, improvements } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title =
  "Website verbeteren zonder alles opnieuw te bouwen | Lorent Webworks";
const description =
  "Heb je al een website die te weinig oplevert? Ik help je met de punten die het meeste verschil maken, ook op WordPress, Wix of Squarespace. Vanaf € 125.";

const hiervoor = [
  "Teksten en pagina-indeling verbeteren",
  "Knoppen en contactroutes aanpassen",
  "Snelheid verbeteren",
  "SEO-basis op orde brengen",
];
const erbuiten = [
  "De hele site herbouwen",
  "Webshops",
  "Kapotte plugins repareren",
  "Maatwerkcode",
];
const stappen = [
  "Je plant een kennismaking.",
  "We kiezen de juiste dienst.",
  "Je geeft toegang tot je site.",
  "Ik voer het werk uit en je krijgt een overzicht van de wijzigingen.",
];

const listClass = "mt-6 flex flex-col gap-3 text-text-soft";
const bullet =
  "relative pl-6 before:absolute before:top-3 before:left-0 before:size-2 before:bg-accent";
---

<BaseLayout title={title} description={description} nav="other" ogType="website">
  <header class="container-page pt-14 pb-12 md:pt-20">
    <h1 class="max-w-4xl text-display font-stretch-116% text-balance">
      Je website verbeteren zonder alles opnieuw te bouwen
    </h1>
    <p class="mt-6 max-w-3xl text-intro text-text-soft">
      Heb je al een site die te weinig oplevert? Ik help je met de punten die het meeste verschil maken, ook als je site
      op WordPress, Wix of Squarespace draait.
    </p>
  </header>

  <section aria-labelledby="diensten-verbeteren" class="container-page pb-20 md:pb-28">
    <h2 id="diensten-verbeteren" class="sr-only">Diensten</h2>
    <div class="grid grid-fit-80 gap-4">
      {
        improvements.map((item) => (
          <article class="flex flex-col rounded-panel bg-surface p-6 md:p-9">
            <h3 class="text-title font-stretch-115%">{item.name}</h3>
            <p class="mt-4 text-title font-stretch-115%">{formatPrice(item.price)}</p>
            <p class="mt-1 text-label text-text-muted">excl. btw, eenmalig</p>
            <p class="mt-6 text-text-soft">{item.text}</p>
            {item.note && <p class="mt-auto pt-6 text-label font-semibold text-text">{item.note}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="hiervoor-titel" class="container-page pb-20 md:pb-28">
    <div class="grid grid-fit-80 gap-12">
      <div>
        <h2 id="hiervoor-titel" class="text-title font-stretch-115%">Hiervoor kun je terecht</h2>
        <ul class={listClass}>
          {hiervoor.map((item) => <li class={bullet}>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-title font-stretch-115%">Dit valt erbuiten</h2>
        <ul class={listClass}>
          {erbuiten.map((item) => <li class={bullet}>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="zo-werkt-het" class="container-page pb-20 md:pb-28">
    <h2 id="zo-werkt-het" class="text-title font-stretch-115%">Zo werkt het</h2>
    <ol class="mt-8 grid grid-fit-70 gap-6">
      {
        stappen.map((stap, i) => (
          <li class="border-t border-border-strong pt-5">
            <span class="text-numeral font-stretch-125% text-accent-text" aria-hidden="true">{i + 1}</span>
            <p class="sr-only">Stap {i + 1}:</p>
            <p class="mt-4 text-lead text-text-soft">{stap}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="verbeteren-cta" class="container-page pb-20 md:pb-28">
    <div class="on-block flex flex-wrap items-center justify-between gap-x-10 gap-y-6 rounded-hero p-6 md:p-12">
      <div class="max-w-2xl">
        <h2 id="verbeteren-cta" class="text-heading font-stretch-115%">Welke punten maken het meeste verschil?</h2>
        <p class="mt-3 text-on-block-muted">
          Plan een gratis kennismaking van 30 minuten. Dan kijken we samen welke dienst bij je site past.
        </p>
      </div>
      <BookButton base="/" variant="on-block" />
    </div>
  </section>
</BaseLayout>
