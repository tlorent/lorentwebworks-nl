---
import BookButton from "../../components/BookButton.astro";
import Icon from "../../components/Icon.astro";
import Pattern from "../../components/Pattern.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import SlotPhoto from "../../components/SlotPhoto.astro";
import { formatPrice, improvements } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title =
  "Website verbeteren zonder alles opnieuw te bouwen | Lorent Webworks";
const description =
  "Heb je al een website die te weinig oplevert? Ik help je met de punten die het meeste verschil maken. Vanaf € 125, excl. btw.";

const stappen = [
  "Je plant een kennismaking.",
  "We kiezen de juiste dienst.",
  "Je geeft toegang tot je site.",
  "Ik voer het werk uit en je krijgt een overzicht van de wijzigingen.",
];
---

<BaseLayout title={title} description={description} nav="verbeteren" ogType="website">
  <section class="relative pt-14 pb-12 md:pt-20 md:pb-16">
    <Pattern variant="dots" />
        <div class="relative container-page">
      <SectionLabel>Bestaande website</SectionLabel>
      <h1 class="mt-6 max-w-5xl text-display font-stretch-116% text-balance">
        Je website verbeteren zonder alles opnieuw te bouwen
      </h1>
      <p class="mt-6 max-w-3xl text-intro text-text-soft">
        Heb je al een site die te weinig oplevert? Ik help je met de punten die het meeste verschil maken.
      </p>
    </div>
  </section>

  <section aria-labelledby="diensten-verbeteren" class="relative section-y">
        <div class="reveal relative container-page">
      <SectionHeader label="Diensten" titleId="diensten-verbeteren">
        <Fragment slot="title">Kies de hulp die bij je past</Fragment>
        <Fragment slot="lead">Drie diensten met een vaste prijs. Je weet vooraf wat je krijgt.</Fragment>
      </SectionHeader>

      <div class="mt-12 grid grid-fit-80 gap-4 md:mt-16">
        {
          improvements.map((item, i) => {
            const inverse = item.variant === "inverse";
            const muted = inverse ? "text-inverse-text/80" : "text-text-muted";
            const titleId = `dienst-verbeteren-${i}`;
            return (
              <article
                aria-labelledby={titleId}
                class:list={[
                  "flex flex-col rounded-panel p-6 md:p-11",
                  inverse ? "bg-inverse-bg bg-glow text-inverse-text" : "bg-surface text-text",
                ]}
              >
                <p class:list={["text-label font-semibold", muted]}>{item.label}</p>
                <h3 id={titleId} class="mt-3 text-title font-stretch-115%">{item.name}</h3>

                <div class:list={["mt-8 rounded-card p-5 md:p-6", inverse ? "bg-inverse-inner" : "bg-inner"]}>
                  <p class="flex flex-col">
                    <strong class="text-price font-stretch-120% whitespace-nowrap">{formatPrice(item.price)}</strong>
                    <span class:list={["mt-1 text-label", muted]}>excl. btw, eenmalig</span>
                  </p>
                </div>

                <h4 class:list={["mt-8 text-sm font-bold", muted]}>Wat je krijgt</h4>
                <ul class="mt-4 flex flex-col gap-3">
                  {item.included.map((line) => (
                    <li class="flex items-start gap-3">
                      <span
                        class:list={[
                          "mt-0.5 grid size-5.5 shrink-0 place-items-center rounded-full",
                          inverse ? "bg-inverse-text text-inverse-bg" : "bg-accent text-on-accent",
                        ]}
                      >
                        <Icon name="check" class="size-3.5" strokeWidth={2.6} />
                      </span>
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>
                {item.note && <p class:list={["mt-6 text-label font-semibold", muted]}>{item.note}</p>}

                <div class="mt-auto pt-10">
                  <BookButton
                    base="/"
                    dienst="verbeteren"
                    label={item.cta}
                    variant={inverse ? "inverse" : "primary"}
                    full
                    size="lg"
                    aria-describedby={titleId}
                  />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="zo-werkt-het" class="relative section-y">
    <Pattern variant="grid" />
    <div class="reveal relative container-page">
      <SectionHeader label="Werkwijze" titleId="zo-werkt-het">
        <Fragment slot="title">Zo werkt het</Fragment>
        <Fragment slot="lead">Vier stappen, van kennismaking tot overzicht van de wijzigingen.</Fragment>
      </SectionHeader>
      <ol class="mt-12 grid grid-fit-70 gap-3.5 md:mt-16">
        {
          stappen.map((stap, i) => (
            <li class="flex flex-col gap-6 rounded-card bg-surface p-6 md:p-7">
              <span class="text-numeral font-stretch-125% text-accent-text" aria-hidden="true">{i + 1}</span>
              <p class="sr-only">Stap {i + 1}:</p>
              <p class="text-lead text-text-soft">{stap}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="verbeteren-cta" class="container-page pb-20 md:pb-28">
    <div class="on-block flex flex-wrap items-center justify-between gap-x-10 gap-y-6 rounded-hero p-6 md:p-12">
      <div class="max-w-2xl">
        <h2 id="verbeteren-cta" class="text-heading font-stretch-115%">Welke punten maken het meeste verschil?</h2>
        <p class="mt-3 text-on-block-muted">
          Plan een gratis kennismaking van 30 minuten. Dan kijken we samen welke dienst bij je site past.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <SlotPhoto name="tim-extra" alt="Foto van Tim Lorent" size={56} />
        <BookButton base="/" variant="on-block" />
      </div>
    </div>
  </section>
</BaseLayout>
