---
import BookButton from "../../components/BookButton.astro";
import ExistingSiteCard from "../../components/ExistingSiteCard.astro";
import NonprofitDiscount from "../../components/NonprofitDiscount.astro";
import Pattern from "../../components/Pattern.astro";
import ProofStrip from "../../components/ProofStrip.astro";
import Schema from "../../components/Schema.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import SlotPhoto from "../../components/SlotPhoto.astro";
import { hostingPrice } from "../../data/booking.mjs";
import {
  extras,
  formatPrice,
  improvements,
  maintenance,
  packageRows,
  services,
} from "../../data/services";
import { schemaIds, site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [lp, bw] = services;
const title = "Website bouwen met vaste prijzen | Lorent Webworks";
const description = `Vaste prijzen voor een Landingspagina (vanaf ${formatPrice(lp.price)}) en een complete website (vanaf ${formatPrice(bw.price)}). Eenmalig, excl. btw, met een overzicht van de extra's.`;
const url = `${site.url}/website-bouwen/`;

const schema = [
  {
    "@type": "WebPage",
    "@id": `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: "nl-NL",
    isPartOf: { "@id": schemaIds.website },
    about: { "@id": schemaIds.organization },
  },
  {
    "@type": "ItemList",
    name: "Website bouwen bij Lorent Webworks",
    itemListElement: services.map((service, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Service",
        name: service.name,
        description: service.description,
        provider: { "@id": schemaIds.organization },
        areaServed: { "@type": "Country", name: "Netherlands" },
        offers: {
          "@type": "Offer",
          priceCurrency: "EUR",
          price: service.price,
          priceSpecification: {
            "@type": "PriceSpecification",
            price: service.price,
            priceCurrency: "EUR",
            valueAddedTaxIncluded: false,
          },
        },
      },
    })),
  },
];

const headCell =
  "pb-5 pr-6 text-left align-bottom text-label font-semibold text-text-muted";
// Op mobiel staat elke rij als blok: onderwerp boven, daarna per optie. Vanaf md is het een gewone tabel.
const rowHead =
  "block pb-3 text-left font-semibold text-text md:table-cell md:border-t md:border-border md:py-4 md:pr-6 md:align-top";
const cell =
  "block pb-3 align-top text-text-soft md:table-cell md:border-t md:border-border md:py-4 md:pr-6";
const rowClass =
  "block border-t border-border py-4 first:border-t-0 md:table-row md:border-0 md:py-0";
---

<BaseLayout title={title} description={description} nav="tarieven">
  <Schema slot="head" data={schema} />
  <section class="relative pt-14 pb-12 md:pt-20 md:pb-16">
            <div class="relative container-page">
      <SectionLabel>Nieuwe website</SectionLabel>
      <h1 class="mt-6 text-display font-stretch-116% text-balance">Website bouwen</h1>
      <p class="mt-6 max-w-3xl text-intro text-text-soft">
        Je weet vooraf wat het kost en wat erin zit. Alle prijzen zijn eenmalig en exclusief btw.
      </p>
    </div>
  </section>

  <section id="opties" aria-labelledby="opties-titel" class="relative section-y">
        <div class="reveal relative container-page">
      <SectionHeader label="Tarieven" titleId="opties-titel">
        <Fragment slot="title">Twee opties met een vaste prijs</Fragment>
        <Fragment slot="lead"
          >Kies de optie die past bij wat je website moet opleveren. De prijzen zijn eenmalig, zonder abonnement.</Fragment
        >
      </SectionHeader>
      <div class="mt-12 grid grid-fit-80 gap-4 md:mt-16">
        <ServiceCard service={lp} onHome={false} />
        <ServiceCard service={bw} onHome={false} />
      </div>
      <div class="mt-10 md:mt-12">
        <ProofStrip />
      </div>
    </div>
  </section>

  <section aria-labelledby="vergelijk-titel" class="relative section-y bg-surface">
    <div class="reveal container-page">
      <SectionHeader label="Vergelijken" titleId="vergelijk-titel">
        <Fragment slot="title">Wat zit er in welke optie?</Fragment>
        <Fragment slot="lead">Het verschil tussen de twee opties in één overzicht.</Fragment>
      </SectionHeader>
      <div
        role="region"
        tabindex="0"
        aria-labelledby="vergelijk-titel"
        class="mt-12 overflow-x-auto rounded-panel bg-inner p-6 focus-ring-wide md:mt-16 md:p-10"
      >
        <table class="block w-full border-collapse md:table md:min-w-2xl">
          <thead class="hidden md:table-header-group">
            <tr>
              <th scope="col"><span class="sr-only">Onderwerp</span></th>
              <th scope="col" class={headCell}>
                <span class="block text-h3 font-stretch-110% text-text">{lp.name}</span>
                <span class="mt-1 block text-accent-text">vanaf {formatPrice(lp.price)}</span>
              </th>
              <th scope="col" class={headCell}>
                <span class="block text-h3 font-stretch-110% text-text">{bw.name}</span>
                <span class="mt-1 block text-accent-text">vanaf {formatPrice(bw.price)}</span>
              </th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group">
            <tr class="block pb-4 md:hidden">
              <th scope="row" class={rowHead}>Prijs</th>
              <td class={cell}>
                <span class="block text-label font-semibold text-text-muted">{lp.name}</span>
                <span class="font-bold text-accent-text">vanaf {formatPrice(lp.price)}</span>
              </td>
              <td class={cell}>
                <span class="block text-label font-semibold text-text-muted">{bw.name}</span>
                <span class="font-bold text-accent-text">vanaf {formatPrice(bw.price)}</span>
              </td>
            </tr>
            {
              packageRows.map((row) => (
                <tr class={rowClass}>
                  <th scope="row" class={rowHead}>{row.label}</th>
                  <td class={cell}>
                    <span class="block text-label font-semibold text-text-muted md:hidden">{lp.name}</span>
                    {row.landingspagina}
                  </td>
                  <td class={cell}>
                    <span class="block text-label font-semibold text-text-muted md:hidden">{bw.name}</span>
                    {row.bedrijfswebsite}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section aria-labelledby="extras-titel" class="relative pt-14 pb-8 md:pt-18 md:pb-12">
    <Pattern variant="grid" />
    <div class="reveal relative container-page">
      <SectionHeader label="Extra's" titleId="extras-titel">
        <Fragment slot="title">Extra's die je erbij kunt nemen</Fragment>
        <Fragment slot="lead">Los te bestellen, naast een optie. Je kiest alleen wat je nodig hebt.</Fragment>
      </SectionHeader>
      <ul class="mt-12 grid grid-fit-70 gap-3.5 md:mt-16">
        {
          extras.map((extra) => (
            <li class="flex flex-col justify-between gap-6 rounded-card border border-border bg-inner p-6 md:p-7">
              <span class="text-h3 font-stretch-110%">{extra.label}</span>
              <span class="flex flex-wrap items-baseline gap-x-2">
                <strong class="text-lead font-stretch-110% text-accent-text">{formatPrice(extra.price)}</strong>
                {extra.unit && <span class="text-label text-text-muted">{extra.unit}</span>}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="erbij-titel" class="relative pt-0 pb-8 md:pb-12">
    <div class="reveal container-page grid grid-fit-80 gap-4">
      <div class="rounded-panel border border-border bg-inner p-6 md:p-10">
        <h2 class="text-h3 font-stretch-110%">{maintenance.name}</h2>
        <p class="mt-4 text-text-soft">
          <strong class="text-lead font-stretch-110% text-accent-text">{formatPrice(maintenance.price)}</strong> per maand, excl. btw
        </p>
      </div>
      <div class="rounded-panel bg-chip-bg p-6 text-chip-text md:p-10">
        <h2 id="erbij-titel" class="text-h3 font-stretch-110%">Valt buiten beide opties</h2>
        <p class="mt-4">
          Webshops, inlogomgevingen, koppelingen op maat, logo-ontwerp, fotografie en het overzetten van bestaande
          content. Heb je dit nodig, dan bespreken we het vooraf en krijg je een aparte prijs.
        </p>
      </div>
      <div class="rounded-panel bg-surface p-6 md:p-10">
        <h2 class="text-h3 font-stretch-110%">Wat komt er nog bij?</h2>
        <p class="mt-4 text-text-soft">
          Je betaalt eenmalig voor de website. Daarnaast heb je een domeinnaam van ongeveer €10 tot €15 per jaar{
            hostingPrice ? ` en hosting van ${hostingPrice} per maand` : ""
          }. Die staan op jouw naam. Betaalde boekings- of doneertools reken je rechtstreeks met de aanbieder af.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="korting-titel-pagina" class="container-page pt-0 pb-8 md:pb-12">
    <h2 id="korting-titel-pagina" class="sr-only">Korting</h2>
    <NonprofitDiscount />
  </section>

  <section aria-label="Heb je al een website?" class="container-page pt-0 pb-8 md:pb-12">
    <ExistingSiteCard />
  </section>

  <section aria-labelledby="tarieven-cta" class="container-page pb-20 md:pb-28">
    <div class="on-block flex flex-wrap items-center justify-between gap-x-10 gap-y-6 rounded-hero p-6 md:p-12">
      <div class="max-w-2xl">
        <h2 id="tarieven-cta" class="text-heading font-stretch-115%">Wil je weten welke optie bij je past?</h2>
        <p class="mt-3 text-on-block-muted">
          Plan een gratis kennismaking van 30 minuten. We bespreken je doel en wat het kost voordat je iets kiest.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <SlotPhoto name="tim-extra" alt="Foto van Tim Lorent" size={56} />
        <BookButton base="/" variant="on-block" />
      </div>
    </div>
  </section>
</BaseLayout>
