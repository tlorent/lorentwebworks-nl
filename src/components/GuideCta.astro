---
import { ctaClass, defaultCta } from "../lib/guide-cta.mjs";
import BookButton from "./BookButton.astro";
import Button from "./Button.astro";
import SlotPhoto from "./SlotPhoto.astro";

type Props = {
  class?: string;
  title?: string;
  text?: string;
  button?: string;
  /** Zonder href gaat de knop naar de boekingslink van de site. */
  href?: string;
};
const {
  class: className = "",
  title = defaultCta.title,
  text = defaultCta.text,
  button = defaultCta.button,
  href,
} = Astro.props;
const titleId = "gids-cta-titel";
---

<aside aria-labelledby={titleId} class:list={[ctaClass.box, className]}>
  <p id={titleId} class={ctaClass.title}>{title}</p>
  <p class={ctaClass.text}>{text}</p>
  <div class="mt-6 flex flex-wrap items-center gap-4">
    <SlotPhoto name="tim-extra" alt="Foto van Tim Lorent" size={56} />
    {
      href ? (
        <Button href={href} variant="on-block">{button}</Button>
      ) : (
        <BookButton variant="on-block" label={button} />
      )
    }
  </div>
</aside>
