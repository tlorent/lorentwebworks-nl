---
// Verwijzing naar de gidspagina over de Lighthouse-score. Dezelfde pill op de homepage en de tarieven-pagina.
import { guideUrl, laagste } from "../data/lighthouse";

const pillTekst =
  laagste === 100
    ? "Mijn website scoort 100 op Lighthouse"
    : `Mijn website scoort minimaal ${laagste} op Lighthouse`;
---

<a href={guideUrl} class="lh pill">
  <span class="check" aria-hidden="true">
    <svg viewBox="0 0 16 16" focusable="false">
      <path d="M4 8.5l2.5 2.5L12 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="pill-tekst">{pillTekst}</span>
  <span class="meer">
    Lees hoe ik dat doe <span class="pijl" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .lh {
    --card: var(--inner);
    --ink: var(--text);
    --muted: var(--text-muted);
    --line: var(--border-strong);
    --chip: var(--chip-bg);
    font-family: var(--font-sans);
    color: var(--ink);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 44px;
    padding: 12px 20px 12px 16px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    max-width: 100%;
    transition: border-color 150ms ease;
  }
  @media (max-width: 40rem) {
    .pill {
      padding: 14px 24px 14px 24px;
    }
  }
  .pill:hover {
    border-color: var(--ink);
  }
  .pill:hover .pijl {
    transform: translateX(2px);
  }
  .pill:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .check {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    flex-shrink: 0;
  }
  .check svg {
    width: 12px;
    height: 12px;
    display: block;
  }
  .pill-tekst {
    text-wrap: balance;
  }
  .meer {
    color: var(--muted);
    font-weight: 500;
    text-wrap: balance;
  }
  .pijl {
    display: inline-block;
    transition: transform 150ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill,
    .pijl {
      transition: none;
    }
    .pill:hover .pijl {
      transform: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
