---
import { site } from "../data/site";
import { buttonClass, buttonIconClass } from "../lib/button.mjs";
import BookButton from "./BookButton.astro";
import Icon from "./Icon.astro";
import Pattern from "./Pattern.astro";
import SectionLabel from "./SectionLabel.astro";
import SlotPhoto from "./SlotPhoto.astro";

const options = [
  { value: "Een landingspagina", id: "landingspagina" },
  { value: "Een bedrijfswebsite", id: "bedrijfswebsite" },
  { value: "Een bestaande website verbeteren", id: "verbeteren" },
  { value: "Weet ik nog niet", id: "weet-niet" },
];

const field =
  "w-full rounded-input field-outline bg-field-bg px-4 py-3 text-base text-text placeholder:text-text-muted focus:border-accent focus:ring-4 focus:ring-chip-bg focus:outline-none aria-invalid:border-danger";
const error = "mt-2 text-sm font-semibold text-danger";
const label = "mb-2 block text-label font-semibold";
const onBlockLink =
  "rounded-md text-on-block underline underline-offset-4 hover:no-underline focus-ring";
---

<section id="contact" aria-labelledby="contact-titel" class="relative section-y">
  <Pattern variant="grid" />
  <div class="reveal relative container-page">
    <div class="on-block flex flex-wrap gap-x-12 gap-y-8 rounded-hero p-5 md:p-12">
      <div class="flex min-w-0 grow basis-95 flex-col">
        <SectionLabel number="06" onBlock>Contact</SectionLabel>
        <h2 id="contact-titel" class="mt-5 text-h2 font-stretch-115% text-balance">
          Vertel me wat je website moet opleveren.
        </h2>
        <p class="mt-6 max-w-lg text-body-lg text-on-block-muted">
          Plan direct 30 minuten in.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <SlotPhoto name="tim-2" alt="Foto van Tim Lorent" size={56} />
          <BookButton base="" variant="on-block" />
        </div>

        <ul class="mt-10 flex flex-col gap-3 text-on-block-muted">
          <li class="flex items-center gap-3">
            <Icon name="pin" class="size-5 shrink-0 text-on-block" />
            {site.city}, voor klanten in heel Nederland
          </li>
          <li class="flex items-center gap-3">
            <Icon name="linkedin" class="size-5 shrink-0 text-on-block" />
            <a href={site.linkedin} rel="noopener" target="_blank" class={onBlockLink}
              >LinkedIn<span class="sr-only"> (opent in een nieuw tabblad)</span></a
            >
          </li>
        </ul>

      </div>

      <div class="focus-accent min-w-0 grow basis-110 rounded-panel bg-form-card p-5 text-text md:p-7">
        <!-- Na verzenden (met JS) komt hier de bevestiging; de focus gaat ernaartoe. -->
        <div data-form-success hidden tabindex="-1" class="rounded-card focus:outline-none">
          <h3 class="text-h3 font-stretch-110%">Dank je, je bericht is binnen.</h3>
          <p class="mt-3 text-text-soft">
            Ik lees het vandaag of de eerstvolgende werkdag en stuur je een voorstel voor een moment om te praten. Tot
            snel.
          </p>
        </div>

        <h3 id="formulier-titel" class="text-h3 font-stretch-110%">Liever eerst een bericht sturen?</h3>
        <form action={site.formEndpoint} method="POST" data-contact-form aria-labelledby="formulier-titel" class="mt-5">
          <input type="hidden" name="_subject" value="Nieuwe aanvraag via lorentwebworks.nl" />
          <!-- Honeypot van Formspree: mensen zien en bereiken dit veld niet, bots vullen het in. -->
          <div class="sr-only" aria-hidden="true">
            <label for="gotcha">Laat dit veld leeg</label>
            <input type="text" id="gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label for="naam" class={label}>Naam</label>
              <input id="naam" name="name" type="text" autocomplete="name" placeholder="Jan de Vries" required class={field} />
              <p id="naam-fout" class={error} hidden>Vul je naam in</p>
            </div>
            <div>
              <label for="email" class={label}>E-mail</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="jan@jouwbedrijf.nl"
                required
                class={field}
              />
              <p id="email-fout" class={error} hidden>Vul een geldig e-mailadres in</p>
            </div>
          </div>

          <fieldset class="mt-5">
            <legend class={label}>Wat heb je nodig? <span class="font-normal text-text-muted">(optioneel)</span></legend>
            <div class="flex flex-wrap gap-2">
              {
                options.map((o) => (
                  <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full field-outline px-4 py-2.75 text-label transition-colors duration-150 hover:border-accent has-checked:border-accent has-checked:bg-chip-bg has-checked:font-semibold has-checked:text-chip-text focus-ring-within">
                    <input type="radio" name="dienst" value={o.value} data-dienst={o.id} class="accent-accent" />
                    {o.value}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="mt-5">
            <label for="bericht" class={label}
              >Vertel kort over je zaak <span class="font-normal text-text-muted">(optioneel)</span></label
            >
            <textarea
              id="bericht"
              name="message"
              rows="4"
              placeholder="Wat doe je, voor wie, en wat moet de website opleveren?"
              class={`${field} resize-y`}></textarea>
          </div>

          <p data-form-error role="alert" class="mt-5 text-sm font-semibold text-danger empty:hidden"></p>

          <button type="submit" class:list={[buttonClass("primary", "lg"), "mt-6 w-full justify-center disabled:opacity-70"]}>
            <span data-submit-label>Plan mijn kennismaking</span>
            <Icon name="arrow" strokeWidth={2.2} class={buttonIconClass("lg")} />
          </button>
          <p class="mt-4 text-center text-sm text-text-muted">
            Ik gebruik je gegevens alleen om contact met je op te nemen. Lees de <a
              href="/privacy/"
              class="rounded-sm underline underline-offset-2 hover:text-accent-text focus-ring">privacyverklaring</a
            >.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const success = document.querySelector<HTMLElement>("[data-form-success]");
    const formError = form.querySelector<HTMLElement>("[data-form-error]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");

    const selectDienst = (id: string | null) => {
      if (!id) return null;
      const radio = form.querySelector<HTMLInputElement>(`input[data-dienst="${CSS.escape(id)}"]`);
      if (radio) radio.checked = true;
      return radio;
    };
    selectDienst(new URLSearchParams(location.search).get("dienst"));

    // Op de homepage: dienst kiezen en naar het formulier scrollen zonder de pagina te herladen.
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-dienst-link]")) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const id = link.dataset.dienstLink ?? "";
        const radio = selectDienst(id);
        history.replaceState(null, "", `?dienst=${encodeURIComponent(id)}#contact`);
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.getElementById("contact")?.scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
        radio?.focus({ preventScroll: true });
      });
    }

    // Eigen foutmeldingen in plaats van de browserballon. De melding hangt alleen aan het veld
    // (aria-describedby) zolang het veld ongeldig is, zodat schermlezers hem niet altijd voorlezen.
    form.noValidate = true;
    const fields = [...form.querySelectorAll<HTMLInputElement>("input[required]")];
    const check = (input: HTMLInputElement) => {
      const valid = input.checkValidity();
      const message = document.getElementById(`${input.id}-fout`);
      if (message) message.hidden = valid;
      if (valid) {
        input.removeAttribute("aria-invalid");
        input.removeAttribute("aria-describedby");
      } else {
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", `${input.id}-fout`);
      }
      return valid;
    };
    for (const input of fields) {
      input.addEventListener("blur", () => input.value && check(input));
      input.addEventListener("input", () => input.hasAttribute("aria-invalid") && check(input));
    }

    const setBusy = (busy: boolean) => {
      if (!submit || !submitLabel) return;
      submit.disabled = busy;
      submitLabel.textContent = busy ? "Versturen..." : "Plan mijn kennismaking";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalid = fields.filter((input) => !check(input));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      if (formError) formError.textContent = "";
      setBusy(true);
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      } catch {
        if (formError) {
          formError.textContent =
            "Het versturen is niet gelukt. Probeer het over een paar minuten opnieuw, of stuur me een bericht via LinkedIn.";
        }
      } finally {
        setBusy(false);
      }
    });
  }
</script>
