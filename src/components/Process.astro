---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import StepPhoto from "./StepPhoto.astro";

// Vijf stappen. Elke stap heeft een foto uit src/assets/ (zie photo).
const steps = [
  {
    title: "Kennismaking",
    photo: "call",
    text: "We bellen via video, 30 minuten. Ik vraag wat je doet, voor wie, en wat de website moet opleveren.",
  },
  {
    title: "Voorstel",
    photo: "voorstel",
    text: "Na het gesprek krijg je een voorstel met prijs, planning en afbakening. Zo weet je precies wat ik ga bouwen.",
  },
  {
    title: "Ontwerpen en bouwen",
    photo: "bouwen",
    text: "Jij levert teksten en foto's aan, want jij kent je klanten het best. Ondertussen ga ik aan de slag met het bouwen.",
  },
  {
    title: "Lancering",
    photo: "oplevering",
    text: "De site gaat live, volledig getest. Dit is het moment dat je met trots jouw website kan doorsturen.",
  },
  {
    title: "Overdracht en nazorg",
    photo: "nazorg",
    text: "Ik laat je zien hoe je zelf kleine dingen aanpast. Je krijgt een uitlegvideo, handleiding en 5 werkdagen support.",
  },
];

const arrowClass =
  "grid size-11 place-items-center rounded-full bg-on-block text-on-block-ink transition-colors duration-150 hover:bg-on-block-muted focus-ring-wide disabled:opacity-40 motion-reduce:transition-none";
---

<section id="aanpak" aria-labelledby="aanpak-titel" class="on-block section-y">
  <div class="reveal container-page">
    <SectionHeader label="Werkwijze" titleId="aanpak-titel" onBlock>
      <Fragment slot="title">Van eerste gesprek tot live in vijf stappen</Fragment>
      <Fragment slot="lead"
        >Jij hebt het druk met je werk. Daarom neem ik het meeste werk uit handen en vraag ik je input alleen op de
        momenten dat die telt.</Fragment
      >
    </SectionHeader>

    <div class="mt-12 md:mt-16">
      <div class="no-js:hidden flex justify-end gap-3">
        <button type="button" data-prev aria-label="Vorige stap" class={arrowClass}>
          <Icon name="arrow" class="size-4.5 rotate-180" strokeWidth={2.2} />
        </button>
        <button type="button" data-next aria-label="Volgende stap" class={arrowClass}>
          <Icon name="arrow" class="size-4.5" strokeWidth={2.2} />
        </button>
      </div>
    </div>
  </div>

  <!-- Buiten de container: de kaarten lopen door tot de rand van het scherm, de eerste staat op de lijn van de tekst. -->
  <div class="reveal mt-6">
    <div
      data-track
      role="region"
      aria-roledescription="carrousel"
      aria-label="Stappen van de werkwijze"
      tabindex="0"
      class="carousel-bleed no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 motion-reduce:scroll-auto focus-ring-wide"
    >
        <ol class="contents">
          {
            steps.map((step, i) => (
              <li
                class="flex shrink-0 snap-start flex-col basis-4/5 md:basis-1/2 lg:basis-2/5"
              >
                <StepPhoto name={step.photo} alt={`Foto bij stap ${i + 1}: ${step.title}`} />
                <h3 class="mt-6 text-h3 font-stretch-110%">{step.title}</h3>
                <p class="mt-3 text-on-block-muted">{step.text}</p>
              </li>
            ))
          }
        </ol>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-next]");
  if (track && prev && next) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const move = (direction: number) => {
      const item = track.querySelector<HTMLElement>("li");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const step = (item?.offsetWidth ?? track.clientWidth) + gap;
      track.scrollBy({ left: direction * step, behavior: reduce ? "auto" : "smooth" });
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
