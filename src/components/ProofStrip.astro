---
// Bewijsblok: Lighthouse-scores van deze site. De waarden staan hier, zodat ze makkelijk aan te passen zijn.
// De kop volgt de scores: staan ze alle vier op 100, dan staat er "scoort 100", anders de laagste score.

const meetdatum = "5 november 2026";
const apparaat = "desktop";
const rapportUrl =
  "https://pagespeed.web.dev/analysis/https-www-lorentwebworks-nl/tjdw68yhbt?form_factor=desktop";

const scores = [
  { label: "Snelheid", score: 100, hint: "Performance" },
  { label: "Toegankelijkheid", score: 100, hint: "Automatische test" },
  { label: "Vindbaarheid", score: 100, hint: "Technische basis" },
  { label: "Best practices", score: 100, hint: "Techniek en veiligheid" },
];

const laagste = Math.min(...scores.map((s) => s.score));
const kop =
  laagste === 100
    ? "Mijn eigen website scoort 100"
    : `Mijn eigen website scoort minimaal ${laagste}`;

const uitleg = [
  {
    kop: "Vindbaarheid:",
    tekst:
      "Dit meet de technische basis van je site voor zoekmachines. Een plek in de zoekresultaten van Google kan niemand garanderen.",
  },
  {
    kop: "Toegankelijkheid:",
    tekst:
      "Dit is een automatische test. Die vindt maar een deel van de problemen, dus een volledige controle vraagt ook handmatig testen, bijvoorbeeld met het toetsenbord en een schermlezer.",
  },
  {
    kop: "Momentopname:",
    tekst: "Scores kunnen per meting een paar punten verschillen.",
  },
];

const straal = 34;
const omtrek = 2 * Math.PI * straal;
---

<section aria-labelledby="proof-titel" class="proof">
  <div class="card">
    <p class="eyebrow">Gemeten met Google Lighthouse</p>
    <h3 id="proof-titel" class="kop">{kop}</h3>
    <p class="inleiding">
      Op snelheid, toegankelijkheid, vindbaarheid en techniek. Jouw website bouw ik op dezelfde manier.
    </p>

    <ul class="scores">
      {
        scores.map((s) => (
          <li class="score" aria-label={`${s.label}: ${s.score} van 100`}>
            <div class="score-ring">
              <svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
                <circle cx="40" cy="40" r={straal} class="spoor" stroke-width="6" fill="none" />
                <circle
                  cx="40"
                  cy="40"
                  r={straal}
                  class="boog"
                  stroke-width="6"
                  fill="none"
                  stroke-linecap="round"
                  stroke-dasharray={`${(omtrek * s.score) / 100} ${omtrek}`}
                  transform="rotate(-90 40 40)"
                />
              </svg>
              <span class="getal">{s.score}</span>
            </div>
            <p class="label">{s.label}</p>
            <p class="hint">{s.hint}</p>
          </li>
        ))
      }
    </ul>

    <div class="uitleg">
      <h4 class="uitleg-kop">Wat deze scores zeggen</h4>
      {
        uitleg.map((u) => (
          <p>
            <strong>{u.kop}</strong> {u.tekst}
          </p>
        ))
      }
    </div>

    <p class="onderregel">
      Gemeten op {apparaat} op {meetdatum} met Google Lighthouse via PageSpeed Insights.
      <a href={rapportUrl} target="_blank" rel="noopener noreferrer" class="link">
        Bekijk het volledige rapport<span class="sr-only"> (opent in een nieuw tabblad)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .proof {
    --card: var(--inner);
    --ink: var(--text);
    --muted: var(--text-muted);
    --line: var(--border);
    --chip: var(--chip-bg);
    --accent: var(--accent-text);
    container: proof / inline-size;
    font-family: var(--font-sans);
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 40px);
    display: grid;
    gap: 28px;
    color: var(--ink);
  }
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .kop {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .inleiding {
    color: var(--muted);
    max-width: 52ch;
  }
  .scores {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
  }
  @container proof (min-width: 560px) {
    .scores {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .score {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .score-ring {
    position: relative;
    width: 92px;
    height: 92px;
  }
  .score-ring svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    overflow: visible;
  }
  .spoor {
    stroke: var(--chip);
  }
  .boog {
    stroke: var(--accent);
  }
  .getal {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .label {
    margin-top: 12px;
    font-weight: 700;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .uitleg {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    display: grid;
    gap: 10px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .uitleg-kop {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }
  .uitleg strong {
    color: var(--ink);
  }
  .onderregel {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 2px;
  }
  .link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
