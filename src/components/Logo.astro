---
// Het rode, schuine L-beeldmerk als inline SVG: geen extra request en scherp op elk scherm.
type Props = { class?: string; label?: string };
const { class: className = "h-6 w-auto text-brand", label } = Astro.props;
---

<svg
  viewBox="0 0 32 48"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <path d="M3.6 0h11.8l-2.2 38H32l-.6 10H0z" fill="currentColor"></path>
</svg>
