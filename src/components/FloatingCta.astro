---
// Zwevende CTA-pil op mobiel en tablet. Verschijnt na de hero, verdwijnt bij de contactsectie.
import { bookingLink } from "../data/booking.mjs";

const link = bookingLink();
---

<div
  data-floating-cta
  class="invisible fixed inset-x-0 bottom-0 z-30 flex translate-y-7/5 justify-center px-3 pt-2.5 pb-safe transition-slide data-show:visible data-show:translate-y-0 motion-reduce:transition-none lg:hidden"
>
  <a
    href={link.href}
    target={link.external ? "_blank" : undefined}
    rel={link.external ? "noopener" : undefined}
    class="flex w-full max-w-md items-center justify-between gap-3 rounded-full bg-text py-2 pr-2 pl-5 text-bg shadow-float focus-ring-wide"
  >
    <span class="text-label font-semibold">Gratis kennismaking, 30 min</span>
    <span class="inline-flex min-h-11 items-center rounded-full bg-accent px-5 text-label font-semibold text-on-accent"
      >Plannen</span
    >
  </a>
</div>

<script>
  const pill = document.querySelector<HTMLElement>("[data-floating-cta]");
  const hero = document.getElementById("hero");
  const contact = document.getElementById("contact");
  if (pill && hero && contact && "IntersectionObserver" in window) {
    const visible = new Map<Element, boolean>([
      [hero, true],
      [contact, false],
    ]);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) visible.set(entry.target, entry.isIntersecting);
      pill.toggleAttribute("data-show", !visible.get(hero) && !visible.get(contact));
    });
    observer.observe(hero);
    observer.observe(contact);
  }
</script>
