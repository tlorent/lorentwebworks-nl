---
import { Picture } from "astro:assets";
import tim from "../assets/tim.jpg";

type Props = { class?: string; size: number };
const { class: className = "", size } = Astro.props;
---

<!-- Klein portret naast tekst: niet het LCP-element, dus geen fetchpriority. -->
<Picture
  src={tim}
  alt="Portret van Tim Lorent"
  width={size * 2}
  height={size * 2}
  widths={[size, size * 2]}
  sizes={`${size}px`}
  fit="cover"
  formats={["avif", "webp"]}
  loading="eager"
  pictureAttributes={{ class: "shrink-0" }}
  class:list={["shrink-0 object-cover", className]}
/>
