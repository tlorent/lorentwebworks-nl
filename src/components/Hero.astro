---
import BookButton from "./BookButton.astro";
import Button from "./Button.astro";
import Pattern from "./Pattern.astro";
import SlotPhoto from "./SlotPhoto.astro";
---

<!-- Geen reveal-animatie: de hero staat boven de vouw en moet direct zichtbaar zijn (LCP). -->
<section id="hero" aria-labelledby="hero-titel" class="relative hero-fill">
  <Pattern variant="glow" />
  <div class="relative container-page text-center">
    <p class="mx-auto mb-6 max-w-sm text-label font-semibold text-balance">
      <span aria-hidden="true" class="mr-2.5 inline-block size-2.5 bg-accent align-middle"></span>
      Website laten maken voor zzp’ers, ondernemers en stichtingen
    </p>
    <h1 id="hero-titel" class="mx-auto text-hero font-stretch-116% text-balance">
      Een website die bij jouw <span class="mark text-accent-text">expertise</span> past
    </h1>

    <div class="mx-auto mt-8 max-w-2xl">
      <p class="text-hero-lead text-text-soft">
        <span class="block">Jij bent goed in je vak. Je website mag dat ook laten zien.</span>
        <span class="block">Vaste prijs vooraf, live binnen 5 werkdagen tot 4 weken, en alles op jouw naam.</span>
      </p>
    </div>

    <div class="mt-8 flex justify-center md:mt-10">
      <div class="relative size-24 -rotate-3">
        <div aria-hidden="true" class="absolute inset-0 translate-x-1.5 translate-y-1.5 rounded-card bg-accent"></div>
        <SlotPhoto name="tim-extra" alt="Foto van Tim Lorent" size={96} class="relative" />
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center md:mt-10">
      <BookButton size="hero" class="justify-center" />
      <Button href="#diensten" variant="secondary" size="hero" class="justify-center border border-text-soft">Bekijk diensten en prijzen</Button>
    </div>
  </div>
</section>
