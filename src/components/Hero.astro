---
import { Image } from "astro:assets";
import timExtra from "../assets/tim-extra.jpg";
import BookButton from "./BookButton.astro";
import Pattern from "./Pattern.astro";
---

<!-- Geen reveal-animatie: de hero staat boven de vouw en moet direct zichtbaar zijn (LCP). -->
<section id="hero" aria-labelledby="hero-titel" class="relative hero-fill">
  <Pattern variant="glow" />
  <div class="relative container-page text-center">
    <h1 id="hero-titel" class="mx-auto mb-6 max-w-sm text-label font-semibold text-balance">
      <span aria-hidden="true" class="mr-2.5 inline-block size-2.5 bg-accent align-middle"></span>
      Website laten maken voor zzp’ers, ondernemers en stichtingen
    </h1>
    <p class="mx-auto text-hero font-stretch-116% text-balance">
      Een website gebouwd rond wat <span class="mark text-accent-text">jij nodig hebt</span>
    </p>

    <div class="mx-auto mt-8 max-w-2xl">
      <p class="text-hero-lead text-text-soft">
        <span class="block text-balance">Voor afspraken, aanvragen, reserveringen of donaties.</span>
        <span class="block">Vaste prijs vooraf en alles op jouw naam.</span>
      </p>
    </div>

    <div class="mt-8 flex flex-col items-center gap-6 md:mt-10">
      <div class="flex w-full flex-col items-center gap-3 sm:flex-row sm:items-center">
        <!-- Twee gelijke flexkolommen naast de knop houden de knop precies in het midden. -->
        <div class="flex items-center justify-center sm:flex-1 sm:justify-end">
          <Image
            src={timExtra}
            alt="Foto van Tim Lorent"
            width={112}
            height={112}
            quality={90}
            class="size-16 shrink-0 rounded-full sm:size-12 object-cover object-top ring-2 ring-bg"
          />
        </div>
        <BookButton size="hero" label="Plan een gratis kennismaking" class="justify-center" />
        <div aria-hidden="true" class="hidden sm:block sm:flex-1"></div>
      </div>
      <div class="flex flex-col items-center sm:flex-row sm:justify-center">
        <a href="#diensten" class="inline-flex min-h-11 items-center rounded-sm px-3 text-sm font-semibold text-accent-text md:text-base underline underline-offset-4 focus-ring">Bekijk diensten</a>
        <a href="/over/" class="inline-flex min-h-11 items-center rounded-sm px-3 text-sm font-semibold text-accent-text md:text-base underline underline-offset-4 focus-ring">Over mij</a>
      </div>
    </div>
  </div>
</section>
