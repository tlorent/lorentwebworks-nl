---
import Icon from "./Icon.astro";

type Props = {
  title: string;
  teaser?: string;
  slug: string;
  readingTime: number;
  order: number;
};
const { title, teaser, slug, readingTime, order } = Astro.props;
---

<article
  class="group relative flex min-h-55 flex-col rounded-card bg-inner p-6 transition-colors duration-150 focus-ring-within md:p-8"
>
  <p class="text-label font-semibold text-accent-text" aria-hidden="true">({String(order).padStart(2, "0")})</p>
  <h3 class="mt-4 text-xl leading-snug font-bold font-stretch-108% tracking-tight">
    <a href={`/gids/${slug}/`} class="outline-none after:absolute after:inset-0">{title}</a>
  </h3>
  {teaser && <p class="mt-3 text-label text-text-muted">{teaser}</p>}
  <div class="mt-auto flex items-center justify-between pt-8">
    <p class="text-label text-text-muted">{readingTime} min lezen</p>
    <span
      aria-hidden="true"
      class="grid size-11 place-items-center rounded-full bg-surface text-text transition-colors duration-150 group-hover:bg-accent group-hover:text-on-accent"
    >
      <Icon name="arrow" class="size-4.5" strokeWidth={2.2} />
    </span>
  </div>
</article>
