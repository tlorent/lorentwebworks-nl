---
import BookButton from "./BookButton.astro";
import SectionHeader from "./SectionHeader.astro";

const results = [
  {
    number: "+45%",
    title: "Abonnementsgroei bij bol.",
    text: "Ik leidde de frontend-architectuurmigratie van het abonnementsplatform. Een activatiecampagne leverde 4.000+ nieuwe abonnees op.",
  },
  {
    number: "+3,4%",
    title: "Conversiegroei bij GrandVision",
    text: "425 nieuwe betalende klanten uit 13.000 interacties. Dezelfde aanpak gebruik ik nu voor zzp en mkb.",
  },
  {
    number: "8+ jaar",
    title: "Ervaring met conversiegerichte websites",
    text: "Van bol. tot kleine ondernemers. Mijn werk draait om wat de site moet opleveren.",
  },
];
---

<section id="resultaten" aria-labelledby="resultaten-titel" class="relative section-y bg-surface">
  <div class="reveal container-page">
    <SectionHeader label="Resultaten" titleId="resultaten-titel">
      <Fragment slot="title">Wat mijn werk heeft opgeleverd</Fragment>
      <Fragment slot="lead"
        >Cijfers uit projecten bij grote merken. Dezelfde aanpak zet ik nu in voor ondernemers en organisaties.</Fragment
      >
    </SectionHeader>

    <!-- Term = waar het resultaat over gaat, beschrijving = het cijfer en de toelichting. -->
    <dl class="mt-12 grid grid-fit-75 gap-3.5 md:mt-16">
      {
        results.map((r, i) => {
          const isBlock = i === results.length - 1;
          return (
            <div
              class:list={[
                "@container flex min-h-85 flex-col gap-3.5 rounded-panel p-6 md:p-10",
                isBlock ? "on-block" : "border border-border bg-inner",
              ]}
            >
              <dt class="order-2 mt-auto text-h3 font-stretch-110%">{r.title}</dt>
              <dd
                class:list={[
                  "order-1 text-stat font-stretch-125% whitespace-nowrap",
                  isBlock ? "text-on-block" : "text-accent-text",
                ]}
              >
                {r.number}
              </dd>
              <dd class:list={["order-3", isBlock ? "text-on-block-muted" : "text-text-soft"]}>{r.text}</dd>
            </div>
          );
        })
      }
    </dl>
    <div class="mt-12 flex justify-start md:mt-16">
      <BookButton />
    </div>
  </div>
</section>
