---
import { clients } from "../data/clients";

// Op mobiel één rij met alle namen, zonder beweging. De rij is afgeknipt en vervaagt aan beide randen, zodat
// op bredere schermen meer namen zichtbaar zijn. Vanaf tablet een doorlopende rij.
// De lijst staat er twee keer in, zodat de lus naadloos aansluit.
const nameClass =
  "whitespace-nowrap font-bold font-stretch-108% tracking-tight text-text-muted";
---

<section aria-label="Ervaring opgedaan bij" class="border-y border-border">
  <div class="reveal-load container-page py-7">
    <p class="mb-4 text-center text-caption font-semibold text-text-muted">Ervaring van grote merken, nu voor jouw website.</p>
    <ul class:list={["mask-fade-x flex justify-center gap-x-4 overflow-hidden text-sm max-xxs:text-xs md:hidden", nameClass]}>
      {clients.map((name) => <li class="shrink-0">{name}</li>)}
    </ul>
    <div class="mask-fade-x hidden overflow-hidden md:block">
      <div class:list={["marquee-track flex w-max text-lg", nameClass]}>
        <ul class="flex shrink-0">
          {clients.map((name) => <li class="shrink-0 pr-10">{name}</li>)}
        </ul>
        <ul aria-hidden="true" class="flex shrink-0">
          {clients.map((name) => <li class="shrink-0 pr-10">{name}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
