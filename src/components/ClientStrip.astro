---
import { clients } from "../data/clients";
// Doorlopende rij met bedrijfsnamen. De lijst staat er twee keer in, zodat de lus naadloos aansluit.
// De randen vervagen. Zonder bewegingsvoorkeur staan de namen stil in één rij.
---

<section aria-label="Ervaring opgedaan bij" class="border-y border-border">
  <div class="reveal-load container-page py-7">
    <p class="mb-4 text-center text-caption font-semibold text-text-muted">Ervaring opgedaan bij</p>
    <div class="mask-fade-x overflow-hidden">
      <div class="marquee-track flex w-max text-lg font-bold font-stretch-108% tracking-tight text-text-muted motion-reduce:w-full">
        <ul class="flex shrink-0 motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center">
          {clients.map((name) => <li class="shrink-0 pr-10 whitespace-nowrap">{name}</li>)}
        </ul>
        <ul aria-hidden="true" class="flex shrink-0 motion-reduce:hidden">
          {clients.map((name) => <li class="shrink-0 pr-10 whitespace-nowrap">{name}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
