---
import { audiences } from "../data/audiences";
import { formatPrice, prices } from "../data/services";
import AudienceItem from "./AudienceItem.astro";
import Button from "./Button.astro";
import Pattern from "./Pattern.astro";
import SectionLabel from "./SectionLabel.astro";
---

<section id="voor-wie" aria-labelledby="voor-wie-titel" class="relative section-y">
  <Pattern variant="grid" />
  <div class="reveal relative container-page flex flex-wrap items-start gap-x-16 gap-y-10">
    <div class="grow-2 basis-90 lg:sticky lg:top-28">
      <SectionLabel number="02">Voor wie</SectionLabel>
      <h2 id="voor-wie-titel" class="mt-5 text-h2 font-stretch-115% text-balance">
        Een website laten maken die past bij wat jij wilt bereiken
      </h2>
      <p class="mt-6 max-w-md text-body-lg text-text-muted">
        Een restaurant wil reserveringen, een coach wil intakes en een goed doel wil donaties. Ik begin daarom bij
        jouw doel en bouw de site daaromheen.
      </p>
      <Button href="#contact" class="mt-8">Plan een kennismaking</Button>
    </div>
    <div class="flex min-w-0 grow-3 basis-130 flex-col gap-2">
      {audiences.map((audience, i) => <AudienceItem audience={audience} open={i === 0} />)}
    </div>
  </div>
  <p class="relative container-page mt-10 max-w-3xl text-body-lg text-text-muted">
    Reserveren, boeken of doneren? Ik plaats de knop of widget van je eigen systeem. Bij de Bedrijfswebsite zit dat
    inbegrepen, bij de Landingspagina kost het {formatPrice(prices.tool)}. Een koppeling op maat bespreken we vooraf.
  </p>
</section>
