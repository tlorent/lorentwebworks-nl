---
import { audiences } from "../data/audiences";
import BookButton from "./BookButton.astro";
import SectionLabel from "./SectionLabel.astro";
---

<section id="voor-wie" aria-labelledby="voor-wie-titel" class="relative section-y">
  <div class="reveal relative container-page">
    <SectionLabel>Voor wie</SectionLabel>
    <h2 id="voor-wie-titel" class="mt-5 text-h2 font-stretch-115% text-balance">Wat moet jouw website opleveren?</h2>
    <p class="mt-5 max-w-2xl text-body-lg text-text-muted">
      Een coach wil afspraken, een adviseur wil aanvragen, een restaurant wil reserveringen en een stichting wil donaties. Ik bouw je site rond dat ene doel.
    </p>
    <p class="mt-4 max-w-2xl text-body-lg text-text-muted">
      Sinds 2017 bouw ik websites en platforms, onder meer voor bol., GrandVision en HEMA. Daar zag ik wat bezoekers
      overtuigt en waar ze afhaken.
    </p>

    <ul class="mt-12 border-t border-border md:mt-16">
      {
        audiences.map((audience) => (
          <li class="grid gap-2 border-b border-border py-6 sm:grid-cols-12 sm:items-baseline sm:gap-6 sm:py-8">
            <h3 class="text-h3 font-stretch-110% sm:col-span-4">{audience.title}</h3>
            <p class="text-label font-bold text-accent-text sm:col-span-3">{audience.forWho}</p>
            <p class="text-text-soft sm:col-span-5">{audience.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 md:mt-16">
      <BookButton />
    </div>
  </div>
</section>
