---
import { services } from "../data/services";
import NonprofitDiscount from "./NonprofitDiscount.astro";
import Pattern from "./Pattern.astro";
import SectionHeader from "./SectionHeader.astro";
import ServiceCard from "./ServiceCard.astro";
---

<section id="diensten" aria-labelledby="diensten-titel" class="relative section-y">
  <Pattern variant="dots" />
  <div class="reveal relative container-page">
    <SectionHeader number="04" label="Diensten en prijzen" titleId="diensten-titel">
      <Fragment slot="title">Kies de website die bij je past</Fragment>
      <Fragment slot="lead"
        >Je weet vooraf wat het kost en wanneer je live staat. De prijzen zijn eenmalig, zonder abonnement.</Fragment
      >
    </SectionHeader>
    <div class="mt-12 grid grid-fit-80 gap-4 md:mt-16">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
    <p class="mt-8">
      <a
        href="/tarieven/"
        class="rounded-sm font-semibold text-accent-text underline underline-offset-4 focus-ring"
        >Bekijk alle tarieven en extra's</a
      >
    </p>
    <NonprofitDiscount />
    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-4 rounded-panel border border-border p-6 md:p-8">
      <div class="max-w-2xl">
        <h3 class="text-h3 font-stretch-110%">Heb je al een website?</h3>
        <p class="mt-2 text-text-soft">Dan kan ik je helpen die te verbeteren, zonder alles opnieuw te bouwen.</p>
      </div>
      <a
        href="/website-verbeteren/"
        class="rounded-sm font-semibold text-accent-text underline underline-offset-4 focus-ring"
        >Bekijk de hulp voor bestaande websites</a
      >
    </div>
  </div>
</section>
