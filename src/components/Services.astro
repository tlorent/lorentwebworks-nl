---
import { services } from "../data/services";
import ExistingSiteCard from "./ExistingSiteCard.astro";
import Pattern from "./Pattern.astro";
import SectionHeader from "./SectionHeader.astro";
import ServiceCard from "./ServiceCard.astro";
---

<section id="diensten" aria-labelledby="diensten-titel" class="relative pt-14 pb-18 md:pt-18 md:pb-24 overflow-x-clip">
  <Pattern variant="grid" />
  <div class="reveal relative container-page">
    <SectionHeader label="Diensten en prijzen" titleId="diensten-titel">
      <Fragment slot="title">Kies de website die bij je past</Fragment>
      <Fragment slot="lead"
        >Je weet vooraf wat het kost en wanneer je live staat. De prijzen zijn eenmalig, zonder abonnement.</Fragment
      >
    </SectionHeader>

    <div class="mt-12 grid grid-fit-80 gap-4 md:mt-16">
      {services.map((service) => <ServiceCard service={service} compact />)}
    </div>

    <div class="mt-12 md:mt-16">
      <ExistingSiteCard />
    </div>
  </div>
</section>
