---
// Korte kennismaking op de homepage, direct onder de strook met bedrijfsnamen.
import { Image } from "astro:assets";
import timPortret from "../assets/tim-full.jpg";
import SectionLabel from "./SectionLabel.astro";
---

<section id="over" aria-labelledby="over-titel" class="relative section-y bg-surface">
  <div class="reveal relative container-page flex flex-col items-center gap-12 lg:flex-row lg:justify-center lg:gap-16">
    <div class="shrink-0">
      <Image
        src={timPortret}
        alt="Portret van Tim Lorent"
        widths={[288, 504, 576]}
        sizes="(min-width: 1024px) 288px, min(90vw, 288px)"
        quality={90}
        class="h-auto w-72 rounded-hero"
      />
    </div>
    <div class="min-w-0 max-w-xl">
      <SectionLabel>Over mij</SectionLabel>
      <p class="mt-5 text-lead font-semibold">Hoi, ik ben Tim van Lorent Webworks</p>
      <h2 id="over-titel" class="mt-5 text-h2 font-stretch-115% text-balance">
        Ervaring van grote merken, op de schaal van jouw zaak
      </h2>
      <p class="mt-6 max-w-2xl text-body-lg text-text-soft">
        Ik bouw al sinds 2017 aan websites en webplatforms, onder meer voor bol., GrandVision en HEMA. Daar zag ik wat
        bezoekers overtuigt en waar ze afhaken.
      </p>
      <a
        href="/over/"
        class="mt-6 inline-block rounded-sm font-semibold text-accent-text underline underline-offset-4 focus-ring"
        >Meer over mij</a
      >
    </div>
  </div>
</section>
