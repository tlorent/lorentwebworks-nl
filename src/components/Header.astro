---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import MobileMenu from "./MobileMenu.astro";
import { type NavKey, navLinks } from "./nav";
import ThemeToggle from "./ThemeToggle.astro";

type Props = { current: NavKey };
const { current } = Astro.props;
const onHome = current === "home";
const links = navLinks(onHome);
const contactHref = onHome ? "#contact" : "/#contact";
---

<a
  href="#inhoud"
  class="sr-only z-50 rounded-full bg-accent px-5 py-3 font-semibold text-on-accent focus-ring-wide focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >Naar inhoud</a
>
<header class="sticky top-0 z-20 border-b border-border bg-bg/95">
  <div class="container-page flex h-19 items-center justify-between gap-3">
    <a href="/" class="-mx-2 shrink-0 rounded-full px-2 py-2 focus-ring">
      <Logo label="Lorent Webworks, naar de homepage" />
    </a>

    <nav aria-label="Hoofdmenu" class="hidden items-center gap-1 lg:flex">
      <ul class="mr-3 flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.key === current ? "page" : undefined}
                class="inline-flex min-h-11 items-center rounded-full px-3.5 py-2.5 text-label font-semibold transition-colors duration-150 hover:bg-surface focus-ring aria-[current=page]:bg-surface"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle class="mr-2" />
      <Button href={contactHref} size="compact">Plan een kennismaking</Button>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2 lg:hidden">
      <Button href={contactHref} size="sm" arrow={false} class="max-xs:px-3.5">Kennismaken</Button>
      <ThemeToggle />
      <button
        type="button"
        commandfor="mobiel-menu"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Menu openen"
        data-menu-open
        class="grid size-11 shrink-0 place-items-center rounded-full bg-surface text-text transition-colors duration-150 hover:bg-border focus-ring-wide"
      >
        <Icon name="menu" class="size-5.5" strokeWidth={2} />
      </button>
    </div>
  </div>
</header>
<MobileMenu current={current} />
