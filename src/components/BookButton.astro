---
// Kennismakingsknop. Gaat naar de boekingslink uit src/data/booking.mjs, of naar het formulier
// als die link nog niet is ingevuld. Een externe link opent in een nieuw tabblad, dat zegt de tekst ook.
import type { HTMLAttributes } from "astro/types";
import { bookingLink } from "../data/booking.mjs";
import Button from "./Button.astro";

type Props = Omit<HTMLAttributes<"a">, "href"> & {
  /** "/" op pagina's die niet de homepage zijn, zodat het formulier op de homepage wordt geopend. */
  base?: string;
  /** Dienst die in het formulier wordt gekozen. Zonder dienst: 'weet-niet'. */
  dienst?: string;
  label?: string;
  variant?: "primary" | "secondary" | "on-block" | "inverse";
  size?: "sm" | "compact" | "md" | "lg";
  full?: boolean;
  arrow?: boolean;
  class?: string;
};
const {
  base = "",
  dienst = "weet-niet",
  label = "Plan een kennismaking",
  variant = "primary",
  size = "md",
  full = false,
  arrow,
  class: className = "",
  ...rest
} = Astro.props;
const link = bookingLink(base, dienst);
---

<Button
  href={link.href}
  variant={variant}
  size={size}
  full={full}
  arrow={arrow}
  class={className}
  target={link.external ? "_blank" : undefined}
  rel={link.external ? "noopener" : undefined}
  data-dienst-link={!link.external && base === "" ? dienst : undefined}
  {...rest}
>
  {label}
  {link.external && <span class="sr-only"> (opent in een nieuw tabblad)</span>}
</Button>
