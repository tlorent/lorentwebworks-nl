---
type Props = { variant: "grid" | "glow" | "stripes" };
const { variant } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute inset-0",
    variant === "grid" && "pattern-2 mask-fade-both",
    variant === "stripes" && "pattern-stripes mask-fade-both",
    variant === "glow" && "hero-glow",
  ]}
>
</div>
