---
import "../styles/global.css";
import FloatingCta from "../components/FloatingCta.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { NavKey } from "../components/nav";
import ThemeScript from "../components/ThemeScript.astro";
import { site } from "../data/site";

type Props = {
  title: string;
  description: string;
  nav?: NavKey;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Absolute URL van de deelafbeelding (3024x1730, hoge resolutie). Standaard /og-image.png. */
  ogImage?: string;
  floatingCta?: boolean;
};

const {
  title,
  description,
  nav = "other",
  noindex = false,
  ogType = "website",
  ogImage = new URL("/og-image.png", site.url).href,
  floatingCta = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="nl" class="scroll-pt-24 motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080b16" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/figtree-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="3024" />
    <meta property="og:image:height" content="1730" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-apQxALwYRdrJkb1yusglG.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg font-sans text-base leading-relaxed text-text antialiased transition-colors duration-200 motion-reduce:transition-none">
    <Header current={nav} />
    <main id="inhoud" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer onHome={nav === "home"} />
    {floatingCta && <FloatingCta />}

    <script>
      // Fallback voor browsers zonder scroll-driven animations.
      if (!CSS.supports("animation-timeline: view()") && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute("data-in", "");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        for (const el of document.querySelectorAll(".reveal")) io.observe(el);
      }

      // Exclusieve accordeons voor browsers zonder ondersteuning voor details[name].
      if (!("name" in HTMLDetailsElement.prototype)) {
        document.addEventListener(
          "toggle",
          (event) => {
            const el = event.target;
            if (!(el instanceof HTMLDetailsElement) || !el.open) return;
            const name = el.getAttribute("name");
            if (!name) return;
            for (const other of document.querySelectorAll<HTMLDetailsElement>(`details[name="${CSS.escape(name)}"]`)) {
              if (other !== el) other.open = false;
            }
          },
          true,
        );
      }
    </script>
  </body>
</html>
